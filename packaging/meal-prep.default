# Environment configuration for meal-prep.service
# Permissions are 0600 (root:root) as this file contains secrets.

# OAuth 2.0 callback URL registered in Google Cloud Console
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback

# 64-hex-character (256-bit) key for AES-256-GCM encryption of OAuth tokens in SQLite.
# Automatically generated by the package post-install script on first install.
